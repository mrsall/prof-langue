# Mot de passe partagé entre ton PC et l'app (même valeur que PC_TTS_TOKEN dans Vercel).
# Choisis une longue phrase sans espace, par exemple : banane-thies-2026-voix-pc
PC_TTS_TOKEN=

# Mode temps réel (V5) : le PC fait répondre Claude lui-même. Même clé que dans Vercel
# (console.anthropic.com → API Keys). Ne la partage jamais.
ANTHROPIC_API_KEY=
# Facultatif : modèle (claude-haiku-5-5 par défaut)
# ANTHROPIC_MODEL=claude-haiku-5-5
