# Copie ce fichier en `.env.local` pour tester sur ton ordinateur,
# ou ajoute ces variables dans Vercel → Settings → Environment Variables.
# Ne mets JAMAIS ces valeurs dans le code ni dans GitHub.

# Clé API ElevenLabs (elevenlabs.io → profil → API Keys)
ELEVENLABS_API_KEY=

# Identifiant de l'agent créé dans ElevenLabs → Agents (commence par "agent_")
ELEVENLABS_AGENT_ID=

# Optionnel : un agent différent par voix (sinon l'agent commun + voix imposée).
# ELEVENLABS_AGENT_ID_BRIAN=
# ELEVENLABS_AGENT_ID_JESSICA=
# ELEVENLABS_AGENT_ID_GEORGE=

# Optionnel : "webrtc" (défaut, recommandé sur mobile) ou "websocket"
# ELEVENLABS_CONNECTION_TYPE=webrtc

# Clé API Anthropic (console.anthropic.com → API Keys). Sert au bilan de fin
# de séance (mots du jour, encouragement). Sans elle, l'app cache cette partie.
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé pour le bilan (défaut : claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optionnel : imposer une voix française précise à un personnage
# (sinon l'app choisit parmi les voix françaises de ton compte ElevenLabs).
# ELEVENLABS_VOICE_FR_AMI=
# ELEVENLABS_VOICE_FR_GRAND_FRERE=
# ELEVENLABS_VOICE_FR_DEBATTEUR=
# ELEVENLABS_VOICE_FR_PROF=
# ELEVENLABS_VOICE_FR_COLLEGUE=
# ELEVENLABS_VOICE_FR_SITUATION=

# Voix du juge en mode débat (facultatif). Par défaut : Daniel en anglais, une voix française de la bibliothèque.
# ELEVENLABS_VOICE_JUDGE_EN=
# ELEVENLABS_VOICE_JUDGE_FR=

# ---- V3 ----
# Base de données Postgres (ex. Supabase → Connect → Transaction pooler).
# Les tables se créent toutes seules. Sans elle : pas de carnet, de suivi,
# de test de niveau ni de rappels (les séances restent sur le téléphone).
DATABASE_URL=

# Code d'accès demandé une fois par appareil (protège tes minutes ElevenLabs).
APP_PIN=

# Optionnel : protège l'appel quotidien du cron (Vercel l'envoie tout seul
# dans l'en-tête Authorization si la variable existe).
# CRON_SECRET=

# Optionnel : contact indiqué aux services de notification push.
# VAPID_SUBJECT=mailto:toi@exemple.com

# --- V4 : prononciation (Azure Speech, portail Azure → ressource Speech → Clés et point de terminaison)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=francecentral
# Facultatif : variantes évaluées (en-GB par défaut pour coller à la voix de George, fr-FR)
# AZURE_LOCALE_EN=en-GB
# AZURE_LOCALE_FR=fr-FR
# Facultatif : voix utilisée pour lire les phrases à répéter (George par défaut en anglais)
# ELEVENLABS_VOICE_TTS_EN=
# ELEVENLABS_VOICE_TTS_FR=

# Facultatif : modèle de transcription de secours ElevenLabs (scribe_v2 par défaut, scribe_v1 sinon)
# ELEVENLABS_STT_MODEL=scribe_v2
