# Copie ce fichier en `.env.local` pour tester sur ton ordinateur,
# ou ajoute ces variables dans Vercel → Settings → Environment Variables.
# Ne mets JAMAIS ces valeurs dans le code ni dans GitHub.

# Clé API ElevenLabs (elevenlabs.io → profil → API Keys)
ELEVENLABS_API_KEY=

# Identifiant de l'agent créé dans ElevenLabs → Agents (commence par "agent_")
ELEVENLABS_AGENT_ID=

# Optionnel : un agent différent par voix (sinon l'agent commun + voix imposée).
# ELEVENLABS_AGENT_ID_BRIAN=
# ELEVENLABS_AGENT_ID_JESSICA=
# ELEVENLABS_AGENT_ID_GEORGE=

# Optionnel : "webrtc" (défaut, recommandé sur mobile) ou "websocket"
# ELEVENLABS_CONNECTION_TYPE=webrtc

# Clé API Anthropic (console.anthropic.com → API Keys). Sert au bilan de fin
# de séance (mots du jour, encouragement). Sans elle, l'app cache cette partie.
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé pour le bilan (défaut : claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optionnel : imposer une voix française précise à un personnage
# (sinon l'app choisit parmi les voix françaises de ton compte ElevenLabs).
# ELEVENLABS_VOICE_FR_AMI=
# ELEVENLABS_VOICE_FR_GRAND_FRERE=
# ELEVENLABS_VOICE_FR_DEBATTEUR=
# ELEVENLABS_VOICE_FR_PROF=
# ELEVENLABS_VOICE_FR_COLLEGUE=
# ELEVENLABS_VOICE_FR_SITUATION=
